---
import { ChevronRight, FileText, Search } from "@lucide/astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/widgets/Header.astro";
import { docsNavigation } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Instalação", description = "Instale e configure o DFeKit." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const toc = [
  ["Instalar", "#install"],
  ["Criar provider", "#create-provider"],
  ["Capabilities", "#capabilities"],
  ["Assinatura", "#signer"],
  ["Validar", "#validate"],
];
---

<BaseLayout title={`${title} | DFeKit`} description={description}>
  <Header docs links={[{ text: "Início", href: "/" }, { text: "Instalação", href: "/docs/installation" }, { text: "Providers", href: "/docs/providers" }]} />
  <div class="sw-container grid gap-8 lg:grid-cols-[240px_minmax(0,760px)_180px]">
    <aside class="hidden border-r border-border py-8 pr-6 lg:block">
      <div class="sticky top-20">
        <div class="mb-6 flex items-center justify-between rounded-md border border-border bg-card/70 px-3 py-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-2"><Search class="size-3.5" />Buscar na documentação</span><span>⌘ K</span>
        </div>
        <nav aria-label="Navegação da documentação">
          {docsNavigation.map((group) => (
            <div class="mb-7">
              <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground">{group.title}</p>
              <div class="space-y-1">
                {group.links.map((link) => {
                  const active = path === link.href.replace(/\/$/, "");
                  return (
                    <a class={`flex items-center gap-2 rounded-md border px-3 py-2 text-sm transition ${active ? "border-primary/40 bg-primary/10 text-foreground" : "border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground"}`} href={link.href}>
                      <FileText class="size-3.5" />
                      <span>{link.text}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </nav>
      </div>
    </aside>

    <main class="sw-prose min-w-0 py-10 lg:py-16">
      <slot />
    </main>

    <aside class="hidden border-l border-border py-20 pl-6 xl:block">
      <div class="sticky top-20">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground">Nesta página</p>
        {toc.map(([label, href]) => (
          <a class="flex items-center gap-1.5 py-1.5 text-xs text-muted-foreground transition hover:text-foreground" href={href}><ChevronRight class="size-3" />{label}</a>
        ))}
      </div>
    </aside>
  </div>
</BaseLayout>

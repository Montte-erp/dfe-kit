---
import { BookOpen, Code, House } from "@lucide/astro";
import Logo from "../Logo.astro";
import Button from "../starwind/Button.astro";
import { landingNavigation } from "../../config";

interface LinkItem {
  text: string;
  href: string;
}

interface Props {
  links?: readonly LinkItem[];
  docs?: boolean;
}

const { links = landingNavigation, docs = false } = Astro.props as Props;
---

<header class="sticky top-0 z-40 w-full border-b border-primary/20 bg-background/80 backdrop-blur-xl">
  <div class="sw-container grid h-14 grid-cols-3 items-center">
    <div class="flex items-center justify-start">
      <Logo />
    </div>
    <nav class="hidden items-center justify-center gap-7 md:flex" aria-label="Navegação principal">
      {links.map((link) => (
        <a class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground transition hover:text-primary-accent" href={link.href}>
          {link.text}
        </a>
      ))}
    </nav>
    <div class="flex items-center justify-end gap-2">
      <Button variant="ghost" size="sm" href={docs ? "/" : "/docs/installation"}>
        {docs ? <House class="size-3.5" /> : <BookOpen class="size-3.5" />}
        <span>{docs ? "Início" : "Documentação"}</span>
      </Button>

      <Button class="hidden lg:inline-flex" variant="outline" size="icon-sm" href="https://github.com/Montte-erp/dfe-kit" ariaLabel="GitHub DFeKit">
        <Code class="size-4" />
      </Button>
    </div>
  </div>
</header>

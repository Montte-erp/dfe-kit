---
import { Code, FileText, ShieldCheck } from "@lucide/astro";

const links = [
  { text: "Instalação", href: "/docs/installation" },
  { text: "Prefeituras", href: "/docs/municipalities" },
  { text: "Estados", href: "/docs/states" },
  { text: "Effect", href: "/docs/effect" },
];
---

<footer class="border-t border-border">
  <div class="sw-container flex flex-col gap-6 py-10 text-xs text-muted-foreground md:flex-row md:items-center md:justify-between">
    <div class="flex flex-wrap gap-4">
      {links.map((link) => <a class="inline-flex items-center gap-1.5 transition hover:text-white" href={link.href}><FileText class="size-3" />{link.text}</a>)}
    </div>
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5"><ShieldCheck class="size-3" />Effect v4 · NFS-e · NF-e · NFC-e</span>
      <a class="transition hover:text-white" href="https://github.com/Montte-erp/dfe-kit" aria-label="GitHub DFeKit"><Code class="size-3.5" /></a>
      <span>© 2026 DFeKit</span>
    </div>
  </div>
</footer>

{
  "name": "@montte-erp/jacobina-saatri",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./__tests__",
    "publint": "publint --strict",
    "publish:github": "bun run build && bun run publint && npm publish --registry=https://npm.pkg.github.com --access public",
    "publish:github:dry": "bun run build && bun run publint && npm publish --registry=https://npm.pkg.github.com --access public --dry-run"
  },
  "dependencies": {
    "better-result": "^2.9.2"
  },
  "devDependencies": {
    "@dfe-kit/adapter-saatri": "workspace:*"
  },
  "nx": {
    "tags": [
      "scope:provider"
    ],
    "implicitDependencies": [
      "@dfe-kit/fiscal",
      "@dfe-kit/adapter-saatri"
    ]
  }
}

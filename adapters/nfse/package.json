{
  "name": "@dfe-kit/adapter-nfse",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./municipal-catalog": {
      "types": "./dist/municipal-catalog.d.ts",
      "import": "./dist/municipal-catalog.js"
    }
  },
  "scripts": {
    "build": "bunup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run ./__tests__"
  },
  "dependencies": {
    "@dfe-kit/fiscal": "workspace:*",
    "@dfe-kit/xml": "workspace:*",
    "effect": "4.0.0-beta.81"
  },
  "nx": {
    "tags": [
      "scope:adapter"
    ],
    "implicitDependencies": [
      "@dfe-kit/fiscal",
      "@dfe-kit/xml"
    ]
  }
}

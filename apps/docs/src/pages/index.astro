---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/widgets/Header.astro";
import Hero from "../components/widgets/Hero.astro";
import HeroProof from "../components/widgets/HeroProof.astro";
import BuiltOn from "../components/widgets/BuiltOn.astro";
import Features from "../components/widgets/Features.astro";
import ManifestConsole from "../components/widgets/ManifestConsole.astro";
import Packages from "../components/widgets/Packages.astro";
import HomologationFirst from "../components/widgets/HomologationFirst.astro";
import Guarantees from "../components/widgets/Guarantees.astro";
import Faq from "../components/widgets/Faq.astro";
import CtaFooter from "../components/widgets/CtaFooter.astro";
import Footer from "../components/widgets/Footer.astro";
---

<BaseLayout>
  <Header />

  <main>
    <Hero />
    <HeroProof />
    <BuiltOn />
    <Features />
    <ManifestConsole />
    <Packages />
    <HomologationFirst />
    <Guarantees />
    <Faq />
    <CtaFooter />
  </main>

  <Footer />
</BaseLayout>

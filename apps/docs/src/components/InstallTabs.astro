---
// Comando de instalação por gerenciador, em Tabs sincronizadas (syncKey="pm").
// Reusado no herói, no CTA e nos docs — escolher pnpm em um lugar reflete em todos.
import { Copy, Check } from "@lucide/astro";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "./starwind/tabs";
import { Tooltip, TooltipTrigger, TooltipContent } from "./starwind/tooltip";
import { site } from "../config";

interface Props {
  syncKey?: string;
  class?: string;
}
const { syncKey = "pm", class: className = "" } = Astro.props as Props;
const managers = [
  { id: "bun", cmd: site.install.bun },
  { id: "npm", cmd: site.install.npm },
  { id: "pnpm", cmd: site.install.pnpm },
];
---

<Tabs defaultValue="bun" syncKey={syncKey} class:list={["w-full max-w-md", className]}>
  <div class="overflow-hidden rounded-xl border border-border bg-card/60 backdrop-blur">
    <TabsList class="h-10 w-full justify-start gap-0 rounded-none border-b border-border bg-transparent p-0">
      {managers.map((m) => (
        <TabsTrigger
          value={m.id}
          class="h-10 rounded-none border-b-2 border-transparent px-4 font-mono text-xs text-muted-foreground data-[state=active]:border-primary data-[state=active]:bg-transparent data-[state=active]:text-foreground"
        >
          {m.id}
        </TabsTrigger>
      ))}
    </TabsList>
    {managers.map((m) => (
      <TabsContent value={m.id} class="m-0">
        <div class="flex items-center gap-3 px-4 py-3 font-mono text-sm">
          <span class="select-none text-primary-accent">$</span>
          <code class="flex-1 truncate text-foreground">{m.cmd}</code>
          <Tooltip openDelay={120}>
            <TooltipTrigger>
              <button
                type="button"
                data-copy
                data-code={m.cmd}
                aria-label="Copiar comando"
                class="grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground transition hover:bg-secondary hover:text-foreground"
              >
                <Copy class="copy-idle size-3.5" />
                <Check class="copy-done hidden size-3.5 text-success" />
              </button>
            </TooltipTrigger>
            <TooltipContent>Copiar</TooltipContent>
          </Tooltip>
        </div>
      </TabsContent>
    ))}
  </div>
</Tabs>

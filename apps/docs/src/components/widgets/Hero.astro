---
import { ArrowRight } from "@lucide/astro";
import { Button } from "../starwind/button";
import { Badge } from "../starwind/badge";
import InstallTabs from "../InstallTabs.astro";
import TriLegend from "../TriLegend.astro";
---

<section class="relative overflow-hidden">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>
  <div class="glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[40rem]"></div>

  <div class="sw-container flex flex-col items-center py-24 text-center lg:py-32">
    <Badge variant="secondary" size="sm" data-reveal class="gap-2">
      <span class="relative flex size-1.5">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex size-1.5 rounded-full bg-primary"></span>
      </span>
      Open-source · Apache-2.0
    </Badge>

    <h1 data-reveal class="mt-6 max-w-4xl text-5xl font-semibold leading-[1.04] tracking-tight text-balance md:text-7xl">
      Documentos fiscais brasileiros, com cada capability <span class="gradient-text">auditável</span>.
    </h1>

    <p data-reveal class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
      NFS-e municipal, NFS-e Nacional, NF-e e NFC-e por prefeitura e por UF. Um contrato fiscal Effect-native — e um
      manifesto que declara, operação por operação, o que está provado em homologação e o que ainda não está.
      Certificado, mTLS e assinatura ficam na sua borda, nunca dentro do kit.
    </p>

    <div data-reveal class="mt-9 flex w-full flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <Button href="/docs" variant="primary" size="lg">
        Ler a documentação <ArrowRight class="size-4" />
      </Button>
      <InstallTabs syncKey="pm" />
    </div>

    <div data-reveal class="mt-10">
      <TriLegend variant="full" class="justify-center" />
    </div>
  </div>
</section>
